#!/data/data/com.termux/files/usr/bin/bash
# EndraTermux Run011 — Smart Push (nlink-v2 transport)
set -euo pipefail
usage() { echo 'Usage: push SOURCE [CALCULATOR_DIRECTORY]'; echo 'Default directory: /'; }
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then usage; exit 0; fi
if (( $# > 2 )); then usage >&2; exit 2; fi
SOURCE="${1:-}"
if [[ -z "$SOURCE" ]]; then read -r -p 'Local file path: ' SOURCE; fi
SOURCE="${SOURCE#file://}"
[[ -f "$SOURCE" && -r "$SOURCE" ]] || { echo "ERROR: Cannot read: $SOURCE" >&2; exit 1; }
DEST="${2:-/}"
[[ "$DEST" == /* ]] || { echo 'ERROR: Destination must start with /' >&2; exit 2; }
# No ambiguous traversal or control characters in destination.
[[ "$DEST" != *'..'* && "$DEST" != *$'\n'* && "$DEST" != *$'\r'* ]] || { echo 'ERROR: Invalid destination' >&2; exit 2; }
[[ "$DEST" == / ]] || DEST="${DEST%/}"
for cmd in termux-usb nlink-v2; do command -v "$cmd" >/dev/null || { echo "ERROR: Missing $cmd" >&2; exit 1; }; done
# Nspire documents need .tns suffix, even for archives; never modify original.
NAME="${SOURCE##*/}"
[[ "$NAME" == *.tns ]] || NAME="$NAME.tns"
WORK="${TMPDIR:-$HOME/.cache}/endra-smart-push"
mkdir -p "$WORK"
STAGED="$(mktemp "$WORK/XXXXXXXX")"
trap 'rm -f -- "$STAGED"' EXIT
cp -- "$SOURCE" "$STAGED"
# Give the staged file its final extension, so nlink-v2 sends the right name.
FINAL="$WORK/$NAME"
if [[ "$STAGED" != "$FINAL" ]]; then
  mv -f -- "$STAGED" "$FINAL"
  STAGED="$FINAL"
fi
USB_LIST="$(termux-usb -l)"
mapfile -t DEVICES < <(printf '%s\n' "$USB_LIST" | grep -oE '/dev/bus/usb/[0-9]+/[0-9]+' | sort -u || true)
DEVICE="${ENDRA_USB_DEVICE:-}"
if [[ -z "$DEVICE" ]]; then
  if (( ${#DEVICES[@]} == 1 )); then DEVICE="${DEVICES[0]}";
  elif (( ${#DEVICES[@]} == 0 )); then echo 'ERROR: No USB devices found' >&2; exit 1;
  else printf 'Multiple USB devices found:\n%s\nSet ENDRA_USB_DEVICE to the calculator USB path.\n' "${DEVICES[*]}" >&2; exit 1; fi
fi
[[ "$DEVICE" =~ ^/dev/bus/usb/[0-9]+/[0-9]+$ ]] || { echo 'ERROR: Invalid USB device' >&2; exit 2; }
printf 'Endra Smart Push Run011\nUSB: %s\nSource: %s\nDestination: %s\nName: %s\n' "$DEVICE" "$SOURCE" "$DEST" "$NAME"
# No root enumeration (known to hang on some calculator OS versions).
# nlink-v2 is the previously proven transfer engine.
printf -v QSOURCE '%q' "$STAGED"
printf -v QDEST '%q' "$DEST"
termux-usb -r -E -e "env LD_LIBRARY_PATH=$PREFIX/lib $PREFIX/bin/nlink-v2 upload $QSOURCE $QDEST" "$DEVICE"
echo 'Upload command completed. Confirm the file appears on the calculator.'
